#!/usr/bin/env python3
"""Software brightness for the HP monitor when it is behind the USB-C hub.

The hub's DP-to-HDMI converter drops DDC/CI, so ddcutil cannot reach the monitor's
backlight. This draws a click-through black layer over that monitor only. It does
not touch gamma, so it does not conflict with gammastep.

  hub-dim run        overlay daemon (started by the kanshi "hub" profile; exits
                     when the monitor goes away)
  hub-dim step N     change the level by N percent and print the new level
"""
import fcntl
import os
import signal
import subprocess
import sys

MODEL = "HP 524sf"
MIN_PCT = 10  # never let the keys black the screen out completely
CACHE = os.path.expanduser("~/.cache")
PCT_FILE = os.path.join(CACHE, "hub-dim-pct")
PCT_LOCK = os.path.join(CACHE, "hub-dim-pct.lock")
DAEMON_LOCK = os.path.join(CACHE, "hub-dim.lock")


def read_pct():
    try:
        with open(PCT_FILE) as f:
            return max(MIN_PCT, min(100, int(f.read())))
    except (OSError, ValueError):
        return 100


def running_daemon_pid():
    """Return the daemon's pid, 0 if it is still starting, None if not running."""
    fd = os.open(DAEMON_LOCK, os.O_RDWR | os.O_CREAT, 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        return None
    except BlockingIOError:
        data = os.read(fd, 32).strip()
        return int(data) if data else 0
    finally:
        os.close(fd)


def step(delta):
    # Spinning the volume knob fires many of these at once.
    with open(PCT_LOCK, "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        pct = max(MIN_PCT, min(100, read_pct() + delta))
        with open(PCT_FILE, "w") as f:
            f.write(str(pct))

    pid = running_daemon_pid()
    if pid is None:
        subprocess.Popen(
            [os.path.abspath(__file__), "run"],
            start_new_session=True,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    elif pid:
        os.kill(pid, signal.SIGUSR1)
    print(pct)


def run():
    lock_fd = os.open(DAEMON_LOCK, os.O_RDWR | os.O_CREAT, 0o600)
    try:
        fcntl.flock(lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        return  # already running; kanshi re-runs this on every reload

    # A key press during startup must not kill us. The level is read after the
    # real handler is installed, so an ignored signal loses nothing.
    signal.signal(signal.SIGUSR1, signal.SIG_IGN)
    os.ftruncate(lock_fd, 0)
    os.write(lock_fd, str(os.getpid()).encode())

    import cairo
    import gi

    gi.require_version("Gdk", "3.0")
    gi.require_version("Gtk", "3.0")
    gi.require_version("GtkLayerShell", "0.1")
    from gi.repository import Gdk, GLib, Gtk, GtkLayerShell

    display = Gdk.Display.get_default()
    monitors = (display.get_monitor(i) for i in range(display.get_n_monitors()))
    monitor = next((m for m in monitors if MODEL in (m.get_model() or "")), None)
    if monitor is None:
        return

    alpha = [0.0]
    window = Gtk.Window()
    GtkLayerShell.init_for_window(window)
    GtkLayerShell.set_namespace(window, "hub-dim")
    GtkLayerShell.set_layer(window, GtkLayerShell.Layer.OVERLAY)
    GtkLayerShell.set_monitor(window, monitor)
    GtkLayerShell.set_exclusive_zone(window, -1)
    GtkLayerShell.set_keyboard_mode(window, GtkLayerShell.KeyboardMode.NONE)
    for edge in (
        GtkLayerShell.Edge.TOP,
        GtkLayerShell.Edge.BOTTOM,
        GtkLayerShell.Edge.LEFT,
        GtkLayerShell.Edge.RIGHT,
    ):
        GtkLayerShell.set_anchor(window, edge, True)

    window.set_visual(window.get_screen().get_rgba_visual())
    window.set_app_paintable(True)

    def on_draw(_widget, cr):
        cr.set_operator(cairo.OPERATOR_SOURCE)
        cr.set_source_rgba(0, 0, 0, alpha[0])
        cr.paint()
        return False

    def on_map(_widget):
        # Empty input region: clicks and scrolling pass through to the windows below.
        window.input_shape_combine_region(cairo.Region())

    def apply_level(*_args):
        pct = read_pct()
        alpha[0] = 1 - pct / 100
        if pct >= 100:
            window.hide()  # no layer at all at full brightness
        else:
            window.show_all()
            window.queue_draw()
        return True  # keep the signal handler installed

    def on_monitor_removed(_display, removed):
        if removed == monitor:
            Gtk.main_quit()

    window.connect("draw", on_draw)
    window.connect("map", on_map)
    display.connect("monitor-removed", on_monitor_removed)
    GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGUSR1, apply_level)
    apply_level()
    Gtk.main()


def main():
    if len(sys.argv) == 2 and sys.argv[1] == "run":
        run()
    elif len(sys.argv) == 3 and sys.argv[1] == "step":
        step(int(sys.argv[2]))
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main()
