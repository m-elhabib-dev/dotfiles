#!/bin/bash
# Wine/XWayland treats the output at 0,0 as the primary monitor, and kanshi puts the
# scaled laptop panel there (1536x864 logical), so games render small on HDMI.
# "external" moves HDMI-A-1 to 0,0 for the game; "restore" lets kanshi put the layout back.
case "$1" in
    external)
        swaymsg -t get_outputs | grep -q '"name": "HDMI-A-1"' || exit 0
        swaymsg output HDMI-A-1 pos 0 0
        swaymsg output eDP-1 pos 1920 0
        ;;
    restore)
        kanshictl reload
        ;;
    *)
        echo "usage: game-display external|restore" >&2
        exit 1
        ;;
esac
