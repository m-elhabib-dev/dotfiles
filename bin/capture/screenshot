#!/bin/bash
# screenshot full|area  -> save to ~/Pictures/Screenshots and copy to clipboard
dir="$HOME/Pictures/Screenshots"
mkdir -p "$dir"
f="$dir/shot_$(date +%Y%m%d_%H%M%S).png"

case "${1:-full}" in
    full)
        out=$(swaymsg -t get_outputs | jq -r '.[] | select(.focused) | .name')
        grim -o "$out" "$f" || { "$HOME/.local/bin/notify-focused" -u critical -a Screenshot -i dialog-error "Screenshot failed" "grim error"; exit 1; }
        ;;
    area)
        geom=$(slurp) || exit 0
        grim -g "$geom" "$f" || { "$HOME/.local/bin/notify-focused" -u critical -a Screenshot -i dialog-error "Screenshot failed" "grim error"; exit 1; }
        ;;
    *) echo "usage: screenshot full|area" >&2; exit 2 ;;
esac

wl-copy -t image/png < "$f"
"$HOME/.local/bin/notify-focused" -a Screenshot -i "$f" -h string:x-canonical-private-synchronous:shot "Screenshot saved" "Copied to clipboard\n$(basename "$f")"

# annotate area shots; edits overwrite the saved file
if [ "$1" = area ] && command -v swappy >/dev/null; then
    swappy -f "$f" -o "$f"
    wl-copy -t image/png < "$f"
fi
