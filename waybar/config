{
    "layer": "top",
    "position": "top",
    "height": 34,
    "spacing": 0,
    "modules-left": [
        "sway/workspaces",
        "custom/powermode",
        "custom/sep",
        "network"
    ],
    "modules-right": [
        "disk",
        "custom/sep",
        "custom/cpu",
        "custom/sep",
        "memory",
        "custom/sep",
        "custom/gpu",
        "backlight",
        "custom/sep",
        "pulseaudio",
        "custom/sep",
        "battery",
        "custom/sep",
        "tray",
        "custom/sep",
    	"sway/language",
        "custom/sep",
        "clock"
    ],

    "sway/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "format": "{name}"
    },

    "tray": {
        "spacing": 10
    },

    "custom/sep": {
        "format": "|",
        "tooltip": false
    },

"clock": { "format": "<span color='#89dceb'>{0:%Y-%m-%d}</span> <span color='#6c7086'>|</span> <span color='#f9e2af'>{0:%H:%M}</span>", "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>" },

"disk": {
    "path": "/",
    "format": " {free}",
    "tooltip-format": "Used: {used}\nFree: {free}\nTotal: {total}",
    "interval": 10
},
    "custom/cpu": {
        "exec": "~/.config/waybar/scripts/cpu.sh",
        "interval": 5,
        "tooltip": false
    },

    "memory": {
        "format": "RAM {}%"
    },


    "sway/language": {
    "format": "{short}"
    },

    "custom/powermode": {
        "exec": "~/.config/waybar/scripts/powermode.sh",
        "return-type": "json",
        "interval": 5
    },

    "custom/gpu": {
        "exec": "~/.config/waybar/scripts/gpu.sh",
        "interval": 5,
        "tooltip": false
    },

    "backlight": {
        "format": "{icon} {percent}%",
        "format-icons": ["", ""]
    },

    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}% {power:.0f}W",
        "format-charging": " {capacity}%",
        "format-plugged": " {capacity}%",
        "format-icons": ["", "", "", "", ""]
    },

    "network": {
    // "interface": "wlp*", // Filter for a specific interface if needed
    "format-wifi": "  {bandwidthDownBytes}",
    "format-ethernet": "  {bandwidthDownBytes}",
    "format-disconnected": "⚠ Disconnected",
    "tooltip-format": "{ifname} via {gwaddr} ",
    "tooltip-format-wifi": "{essid} ({signalStrength}%) ",
    "tooltip-format-ethernet": "{ifname} ",
    "tooltip-format-disconnected": "Disconnected",
    "interval": 2, // Update every 2 seconds for accuracy
    "max-length": 50
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "",
        "format-icons": {
            "default": ["", "", ""]
        },
        "on-click": "pavucontrol"
    }

}
