(defpoll time :interval "1s" `date +%H:%M`)
(defpoll date :interval "60s" `date "+%A, %B %-d"`)
; Written by clock-colors; polled (not a defvar) so it survives eww config reloads
(defpoll colors :interval "5s"
  :initial `{"tone":"dark","time":"#b4befe","date":"#a6adc8"}`
  `cat ~/.cache/eww-clock-colors.json 2>/dev/null || echo '{"tone":"dark","time":"#b4befe","date":"#a6adc8"}'`)

(defwindow clock [mon]
  :monitor mon
  :stacking "bottom"
  :focusable false
  :exclusive false
  :windowtype "desktop"
  :geometry (geometry
    :x "0px"
    :y "50px"
    :anchor "bottom center"
    :width "560px"
    :height "300px")

  (box :class "clock-box ${colors.tone}"
       :orientation "v"
       :halign "center"
       :valign "end"
       :space-evenly false
    (label :class "time" :halign "center" :style "color: ${colors.time};" :text time)
    (label :class "date" :halign "center" :style "color: ${colors.date};" :text date)))
